# --- Python -----------------------------------------------------------
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Secrets & environment -------------------------------------------
# Ignore every .env variant (including the .env.bak* backups holding real
# secrets) but allow a committed, secret-free template if one is added.
.env
.env.*
!.env.example

# Session cookies captured during manual testing — real credentials.
cookies.txt
fresh_cookies.txt

# --- Local databases --------------------------------------------------
# The seeded dev-preview SQLite and any other local DB. Never committed.
*.db
*.sqlite
*.sqlite3

# --- Editor / OS cruft ------------------------------------------------
.DS_Store
# AppleDouble resource-fork stubs (`._foo.py`) — Finder metadata, not content.
# 95 of them were copied into this tree with the repo; ignored so a stray one
# can never be committed, and so `git status` stays readable.
._*

# --- Node (build-time only) -------------------------------------------
# Tailwind's compiler and its plugins. Build-time only — nothing here is
# imported at runtime, and the app serves no JavaScript from it.
#
# package.json and package-lock.json ARE committed: the lock file is what
# makes `npm ci` reproduce this exact compiler, and a stylesheet built by a
# different Tailwind is a different stylesheet.
#
# app/static/css/tailwind.css is committed too, deliberately. It is generated,
# but it is also the only thing standing between a fresh checkout and a page
# with no styling at all, and deploy must not depend on Node being present.
#
# Same reasoning for app/static/fonts/ (11 woff2, 1.4 MB) and the fonts.css
# that indexes them, generated by scripts/vendor_fonts.py. They are binary and
# they are large, which is a real argument for keeping them out — but the
# alternative is a deploy that has to reach fonts.googleapis.com to look right,
# which is the exact dependency vendoring them removed. They change only when
# the font URLs in base.html change, so they will not churn.
node_modules/

# --- Backups / one-off artifacts -------------------------------------
*.bak
*.bak_*
/cartflow_app_skeleton.zip

# --- Claude Code local state -----------------------------------------
.claude/settings.local.json
.claude/.cc-writes/

.claude/
*.bak
*.db
cookies*.txt
inspect_report.txt
